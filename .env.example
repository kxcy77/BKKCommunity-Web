APP_ENV=development
APP_URL=http://localhost:8080
APP_BASE_PATH=
APP_SESSION_NAME=bkk_community_session
# Set true only behind a trusted reverse proxy that supplies X-Forwarded-Proto.
APP_TRUST_PROXY=false

# Leave DB_HOST empty to use the clearly labelled session-only demo mode.
DB_HOST=
DB_PORT=3306
DB_NAME=bkk_community
DB_USER=bkk_app
DB_PASSWORD=change-me

# Required before password-reset emails can be sent.
MAIL_FROM=
