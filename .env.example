APP_ENV=development
APP_URL=http://localhost:8080
APP_BASE_PATH=
APP_SESSION_NAME=bkk_community_session
# Set true only behind a trusted reverse proxy that supplies X-Forwarded-Proto.
APP_TRUST_PROXY=false

# Leave DB_HOST empty to use the clearly labelled session-only demo mode.
DB_HOST=
DB_PORT=3306
DB_NAME=bkk_community
DB_USER=bkk_app
DB_PASSWORD=change-me

# Required together for 6-digit password-reset codes. Generate RESET_CODE_SECRET
# with: php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
RESET_CODE_SECRET=
# Preferred on Railway Free, Trial and Hobby plans because it uses HTTPS.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
MAIL_FROM=
MAIL_FROM_NAME=BKK Community
